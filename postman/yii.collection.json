        {
          "name": "login admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.expect([200]).to.include(pm.response.code));",
                  "pm.test('format response seragam', () => { const j = pm.response.json(); pm.expect(j).to.have.property('success'); pm.expect(j).to.have.property('message'); });",
                  "pm.collectionVariables.set('token_admin', pm.response.json().data.access_token);",
                  "pm.test('ada access_token', () => pm.expect(pm.response.json().data.access_token).to.be.a('string'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "http://127.0.0.1:8088/api/v1/auth/login",
            "body": {

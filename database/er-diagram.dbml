// ERD SIMRS Inova — dihasilkan dari database/schema.sql
// Tempel ke https://dbdiagram.io untuk render visual.

Table INTEGRATION_API_LOG {
  id bigint [pk]
  request_id varchar(64)
  method varchar(10)
  path text
  status integer
  duration_ms integer
  user_id bigint
  ip varchar(45)
  created_at timestamp
}

Table INTEGRATION_INBOX {
  id bigint [pk]
  source text
  external_ref varchar(100) [unique]
  payload jsonb
  status text
  attempts integer
  last_error text
  created_at timestamp
  processed_at timestamp
}

Table INTEGRATION_OUTBOX {
  id bigint [pk]
  aggregate_type text
  aggregate_id bigint
  event_type text
  payload jsonb
  idempotency_key uuid [unique]
  status text
  attempts integer
  next_retry_at timestamp
  last_error text
  created_at timestamp
  sent_at timestamp
}

Table AUDIT_LOGS {
  id bigint [pk]
  table_name varchar(60)
  record_id bigint
  action varchar(20)
  old_data jsonb
  new_data jsonb
  user_id bigint
  ip varchar(45)
  created_at timestamp
}

Table AUTH_ASSIGNMENT {
  item_name varchar(64)
  user_id varchar(64)
  created_at integer
  indexes {
    (item_name, user_id) [pk]
  }
}

Table AUTH_ITEM {
  name varchar(64) [pk]
  type smallint
  description text
  rule_name varchar(64)
  data bytea
  created_at integer
  updated_at integer
}

Table AUTH_ITEM_CHILD {
  parent varchar(64)
  child varchar(64)
  indexes {
    (parent, child) [pk]
  }
}

Table AUTH_RULE {
  name varchar(64) [pk]
  data bytea
  created_at integer
  updated_at integer
}

Table DIAGNOSES {
  id bigint [pk]
  visit_id bigint
  medical_record_id bigint
  icd10_code varchar(10)
  name varchar(200)
  type char(1)
  notes text
  is_active boolean
  created_at timestamp
}

Table DISPENSINGS {
  id bigint [pk]
  prescription_id bigint
  dispensed_by bigint
  dispensed_at timestamp
  notes text
}

Table DOCTOR_SCHEDULES {
  id bigint [pk]
  doctor_id bigint
  poli_id bigint
  day_of_week integer
  start_time time
  end_time time
  quota integer
  is_active boolean
  created_at timestamp
  updated_at timestamp
  indexes {
    (doctor_id, poli_id, day_of_week, start_time) [unique]
  }
}

Table DOCTORS {
  id bigint [pk]
  str_no varchar(30) [unique]
  name varchar(150)
  specialization varchar(100)
  phone varchar(20)
  is_active boolean
  created_at timestamp
  updated_at timestamp
}

Table INVOICE_ITEMS {
  id bigint [pk]
  invoice_id bigint
  ref_type varchar(20)
  ref_id bigint
  description varchar(200)
  qty numeric(12,2)
  unit_price numeric(14,2)
  amount numeric(14,2)
  status varchar(10)
  void_reason text
  created_at timestamp
  updated_at timestamp
}

Table INVOICE_REVISIONS {
  id bigint [pk]
  invoice_id bigint
  revision integer
  snapshot jsonb
  reason text
  created_by bigint
  created_at timestamp
}

Table INVOICES {
  id bigint [pk]
  invoice_no varchar(30) [unique]
  visit_id bigint [unique]
  status varchar(10)
  total numeric(14,2)
  paid_total numeric(14,2)
  refund_due numeric(14,2)
  revision integer
  created_at timestamp
  updated_at timestamp
}

Table LAB_ORDER_ITEMS {
  id bigint [pk]
  lab_order_id bigint
  lab_test_id bigint
  unit_price numeric(14,2)
  status varchar(15)
  created_at timestamp
}

Table LAB_ORDERS {
  id bigint [pk]
  order_no varchar(30) [unique]
  visit_id bigint
  status varchar(15)
  ordered_by bigint
  notes text
  created_at timestamp
  updated_at timestamp
}

Table LAB_RESULTS {
  id bigint [pk]
  lab_order_item_id bigint
  external_ref varchar(100) [unique]
  result_value text
  unit varchar(30)
  ref_range varchar(100)
  flag varchar(10)
  verified_by bigint
  verified_at timestamp
  notes text
  created_at timestamp
}

Table LAB_TESTS {
  id bigint [pk]
  code varchar(30) [unique]
  name varchar(150)
  unit varchar(30)
  ref_range varchar(100)
  price numeric(14,2)
  category varchar(50)
  is_active boolean
  created_at timestamp
  updated_at timestamp
}

Table MEDICAL_RECORD_REVISIONS {
  id bigint [pk]
  medical_record_id bigint
  visit_id bigint
  revision integer
  snapshot jsonb
  reason text
  created_by bigint
  created_at timestamp
}

Table MEDICAL_RECORDS {
  id bigint [pk]
  visit_id bigint [unique]
  anamnesis text
  blood_pressure varchar(20)
  temperature numeric(4,1)
  pulse integer
  respiration integer
  weight numeric(5,1)
  height numeric(5,1)
  physical_exam text
  notes text
  revision integer
  created_by bigint
  updated_by bigint
  created_at timestamp
  updated_at timestamp
}

Table MEDICINES {
  id bigint [pk]
  code varchar(30) [unique]
  name varchar(150)
  unit varchar(20)
  price numeric(14,2)
  stock integer
  category varchar(50)
  is_active boolean
  created_at timestamp
  updated_at timestamp
}

Table MIGRATION {
  version varchar(180) [pk]
  apply_time integer
}

Table PATIENTS {
  id bigint [pk]
  mrn varchar(20) [unique]
  nik varchar(16)
  name varchar(150)
  birth_date date
  gender char(1)
  phone varchar(20)
  address text
  blood_type varchar(3)
  allergy text
  created_at timestamp
  updated_at timestamp
}

Table PAYMENTS {
  id bigint [pk]
  payment_no varchar(30) [unique]
  invoice_id bigint
  method varchar(12)
  amount numeric(14,2)
  idempotency_key uuid [unique]
  request_hash char(64)
  paid_at timestamp
  cashier_id bigint
  created_at timestamp
}

Table POLIS {
  id bigint [pk]
  code varchar(20) [unique]
  name varchar(100)
  registration_fee numeric(14,2)
  description text
  is_active boolean
  created_at timestamp
  updated_at timestamp
}

Table PRESCRIPTION_ITEMS {
  id bigint [pk]
  prescription_id bigint
  medicine_id bigint
  dose varchar(50)
  frequency varchar(50)
  qty integer
  unit_price numeric(14,2)
  created_at timestamp
}

Table PRESCRIPTIONS {
  id bigint [pk]
  prescription_no varchar(30) [unique]
  visit_id bigint
  status varchar(12)
  notes text
  created_by bigint
  processed_by bigint
  dispensed_by bigint
  submitted_at timestamp
  processed_at timestamp
  dispensed_at timestamp
  created_at timestamp
  updated_at timestamp
}

Table PROCEDURES {
  id bigint [pk]
  code varchar(30) [unique]
  name varchar(150)
  price numeric(14,2)
  category varchar(50)
  is_active boolean
  created_at timestamp
  updated_at timestamp
}

Table QUEUE_COUNTERS {
  doctor_id bigint
  visit_date date
  last_no integer
  indexes {
    (doctor_id, visit_date) [pk]
  }
}

Table STOCK_MOVEMENTS {
  id bigint [pk]
  medicine_id bigint
  qty_change integer
  stock_after integer
  ref_type varchar(20)
  ref_id bigint
  reason text
  created_by bigint
  created_at timestamp
}

Table USERS {
  id bigint [pk]
  username varchar(50) [unique]
  password_hash varchar(255)
  full_name varchar(150)
  role varchar(20)
  is_active boolean
  last_login_at timestamp
  created_at timestamp
  updated_at timestamp
}

Table VISIT_PROCEDURES {
  id bigint [pk]
  visit_id bigint
  procedure_id bigint
  qty integer
  unit_price numeric(14,2)
  status varchar(10)
  void_reason text
  created_by bigint
  created_at timestamp
  updated_at timestamp
}

Table VISITS {
  id bigint [pk]
  visit_no varchar(30) [unique]
  patient_id bigint
  doctor_id bigint
  poli_id bigint
  visit_date date
  queue_no integer
  guarantor_type varchar(10)
  status varchar(12)
  complaint text
  cancel_reason text
  created_by bigint
  created_at timestamp
  updated_at timestamp
  indexes {
    (doctor_id, visit_date, queue_no) [unique]
  }
}

Ref: INTEGRATION_API_LOG.user_id > USERS.id

Ref: AUDIT_LOGS.user_id > USERS.id

Ref: AUTH_ASSIGNMENT.item_name > AUTH_ITEM.name

Ref: AUTH_ASSIGNMENT.user_id > USERS.id

Ref: AUTH_ITEM.rule_name > AUTH_RULE.name

Ref: AUTH_ITEM_CHILD.child > AUTH_ITEM.name
Ref: AUTH_ITEM_CHILD.parent > AUTH_ITEM.name

Ref: DIAGNOSES.medical_record_id > MEDICAL_RECORDS.id

Ref: DIAGNOSES.visit_id > VISITS.id

Ref: DISPENSINGS.prescription_id > PRESCRIPTIONS.id

Ref: DISPENSINGS.dispensed_by > USERS.id

Ref: DOCTOR_SCHEDULES.doctor_id > DOCTORS.id

Ref: DOCTOR_SCHEDULES.poli_id > POLIS.id

Ref: INVOICE_ITEMS.invoice_id > INVOICES.id

Ref: INVOICE_REVISIONS.invoice_id > INVOICES.id

Ref: INVOICE_REVISIONS.created_by > USERS.id

Ref: INVOICES.visit_id > VISITS.id

Ref: LAB_ORDER_ITEMS.lab_order_id > LAB_ORDERS.id

Ref: LAB_ORDER_ITEMS.lab_test_id > LAB_TESTS.id

Ref: LAB_ORDERS.ordered_by > USERS.id

Ref: LAB_ORDERS.visit_id > VISITS.id

Ref: LAB_RESULTS.lab_order_item_id > LAB_ORDER_ITEMS.id

Ref: LAB_RESULTS.verified_by > USERS.id

Ref: MEDICAL_RECORD_REVISIONS.medical_record_id > MEDICAL_RECORDS.id

Ref: MEDICAL_RECORD_REVISIONS.created_by > USERS.id

Ref: MEDICAL_RECORD_REVISIONS.visit_id > VISITS.id

Ref: MEDICAL_RECORDS.created_by > USERS.id
Ref: MEDICAL_RECORDS.updated_by > USERS.id

Ref: MEDICAL_RECORDS.visit_id > VISITS.id

Ref: PAYMENTS.invoice_id > INVOICES.id

Ref: PAYMENTS.cashier_id > USERS.id

Ref: PRESCRIPTION_ITEMS.medicine_id > MEDICINES.id

Ref: PRESCRIPTION_ITEMS.prescription_id > PRESCRIPTIONS.id

Ref: PRESCRIPTIONS.created_by > USERS.id
Ref: PRESCRIPTIONS.dispensed_by > USERS.id
Ref: PRESCRIPTIONS.processed_by > USERS.id

Ref: PRESCRIPTIONS.visit_id > VISITS.id

Ref: QUEUE_COUNTERS.doctor_id > DOCTORS.id

Ref: STOCK_MOVEMENTS.medicine_id > MEDICINES.id

Ref: STOCK_MOVEMENTS.created_by > USERS.id

Ref: VISIT_PROCEDURES.procedure_id > PROCEDURES.id

Ref: VISIT_PROCEDURES.created_by > USERS.id

Ref: VISIT_PROCEDURES.visit_id > VISITS.id

Ref: VISITS.doctor_id > DOCTORS.id

Ref: VISITS.patient_id > PATIENTS.id

Ref: VISITS.poli_id > POLIS.id

Ref: VISITS.created_by > USERS.id

